{
  "name": "tx27---twinx27",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:v2",
    "dev:v1": "vite --mode v1 --host --port 9999",
    "dev:v2": "vite --mode v2 --host --port 9999",
    "build": "npm run build:v2",
    "build:v1": "tsc -b tsconfig.v1.json tsconfig.node.json && vite build --mode v1",
    "build:v2": "tsc -b tsconfig.v2.json tsconfig.node.json && vite build --mode v2",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run deploy:v1",
    "deploy:v1": "npm run build:v1 && gh-pages -d dist",
    "deploy:v2": "npm run build:v2 && gh-pages -d dist",
    "deploy:beta": "npm run build:v2 && gh-pages -d dist -b beta"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "gh-pages": "^6.3.0",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  }
}
